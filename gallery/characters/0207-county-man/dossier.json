  "storylines": [
    {
      "title": "形象升级线：从“老爷们就得糙”到研究护肤",
      "event_ids": [
        "E001",
        "E002"
      ],
      "narrative": "文本先指出这两年县城里的老爷们开始研究发型、穿搭和护肤，男性护肤被说成正儿八经的风口行业，过去“老爷们就得糙”的观念不再吃香。随后文案给出建议：不是涂脂抹粉，而是基础清洁，把脸洗干净、洗白净，自信从容的县城小布尔乔亚气质自然会回来。冲突在旧式糙汉观念与新形象消费之间；原文没有交代这一转变的起因、结果和实际效果。",
      "unresolved": "是否所有县城男人都如此；他们是否真的购买和使用；洗白净与气质恢复之间是否为广告宣称；具体消费金额、品牌效果均未交代。",
      "evidence": [
        {
          "index": 139,
          "url": "https://www.douyin.com/video/7626702236432764198"
        }
      ]
    },
    {
      "title": "酒桌生存线：面子、人精与选酒人脉",
      "event_ids": [
        "E003",
        "E004",
        "E005",
        "E006"
      ],
      "narrative": "第二条线把县城男人放回面子社会。县城被概括为就俩字“面子”，男人混到一定年纪后，混得好不因挣钱多少，而因坐得住饭局、说得起场面话、喝得了三轮酒。酒桌被写成社会价值考场：要识趣、顺坡、说话有火候、该敬谁不该抢谁；生存法则不是拼背景，是拼谁更像人精。选酒也有门道，山寨五粮液掉价，飞天茅台会被猜假，老江湖喝什么酒能看出门道。文本以单位十年不升不走的哥们为例：他专挑别人喝不动的饭局去顶，一次陪老领导吃饭端上赖氏父子，讲出赖茅来路，老领导未喝先笑，称他“有点东西”。最后文本总结，能从一瓶酒聊出人情世故，就不是一顿饭，而是一张人脉网。",
      "unresolved": "哥们是否因此升迁或获得实际资源；饭局故事真实性；赖氏父子是否只是广告植入；县城酒桌规则的具体适用范围；不同收入、不同单位的人是否都如此。",
      "evidence": [
        {
          "index": 285,
          "url": "https://www.douyin.com/video/7504487348304268604"
        }
      ]
    }
  ],
